# Linux Daily Tips - Frontend Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# API Configuration
# =============================================================================

# Backend API Base URL
# Development: http://localhost:8000
# Production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# API Timeout (in milliseconds)
NEXT_PUBLIC_API_TIMEOUT=30000

# =============================================================================
# Feature Flags
# =============================================================================

# Enable React Query DevTools (development only)
NEXT_PUBLIC_ENABLE_DEVTOOLS=true

# Enable debug mode (shows additional logging)
NEXT_PUBLIC_DEBUG_MODE=false

# =============================================================================
# Authentication
# =============================================================================

# JWT Token storage key (optional, has default)
NEXT_PUBLIC_AUTH_TOKEN_KEY=auth-token

# Session timeout (in minutes)
NEXT_PUBLIC_SESSION_TIMEOUT=60

# =============================================================================
# Google AdSense (for Phase 3)
# =============================================================================

# Google AdSense Client ID
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# =============================================================================
# Analytics (optional)
# =============================================================================

# Google Analytics ID
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# =============================================================================
# Terminal Configuration
# =============================================================================

# Terminal WebSocket URL (if different from API URL)
# NEXT_PUBLIC_TERMINAL_WS_URL=ws://localhost:8000/ws

# Terminal session timeout (in minutes)
NEXT_PUBLIC_TERMINAL_TIMEOUT=30

# =============================================================================
# Application Settings
# =============================================================================

# App Name
NEXT_PUBLIC_APP_NAME=Linux Daily Tips

# App URL (used for SEO and social sharing)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Base URL for metadata (metadataBase in layout.tsx)
# Development: http://localhost:3000
# Production: https://linuxdailytips.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Contact Email
NEXT_PUBLIC_CONTACT_EMAIL=admin@linuxdailytips.com

# =============================================================================
# Development Only
# =============================================================================

# Mock API responses (useful for frontend development without backend)
NEXT_PUBLIC_MOCK_API=false

# Delay for mock API responses (in milliseconds)
NEXT_PUBLIC_MOCK_API_DELAY=1000
