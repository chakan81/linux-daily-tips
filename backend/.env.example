# =============================================================================
# Linux Daily Tips Backend - 환경 변수 템플릿
# =============================================================================
# 이 파일을 복사하여 .env 파일을 생성하세요:
#   cp .env.example .env
#
# 상세 가이드: docs/environment-variables.md
# =============================================================================

# =============================================================================
# 📌 필수 환경 변수 (프로덕션)
# =============================================================================

# 🔐 보안 설정
# -----------------------------------------------------------------------------
# JWT 토큰 서명용 시크릿 키 (최소 32자 이상)
# 생성 방법: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 개발 환경: 자동 생성됨 (경고 로그 출력)
# 프로덕션: 반드시 설정 필요 (미설정 시 서버 시작 실패)
SECRET_KEY=

# JWT 토큰용 별도 시크릿 키 (SECRET_KEY와 다르게 설정 권장)
JWT_SECRET_KEY=

# Redis 세션 데이터 암호화 키 (Fernet 키, 44자 Base64)
# 생성 방법: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 개발 환경: 자동 생성됨 (경고 로그 출력)
# 프로덕션: 반드시 설정 필요 (잘못된 형식 시 서버 시작 실패)
REDIS_ENCRYPTION_KEY=

# 🗄️ 데이터베이스 설정
# -----------------------------------------------------------------------------
# PostgreSQL 비동기 연결 URL
# 개발 환경 (Docker Compose): postgresql+asyncpg://postgres:postgres@db:5432/linux_daily_tips
# 로컬 개발: postgresql+asyncpg://postgres:postgres@localhost:5432/linux_daily_tips
# 프로덕션: postgresql+asyncpg://user:password@db-host:5432/dbname
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/linux_daily_tips

# PostgreSQL 개별 설정 (DATABASE_URL과 일관성 유지)
POSTGRES_DB=linux_daily_tips
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_HOST=db
DATABASE_PORT=5432

# 데이터베이스 연결 풀 설정
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Redis 연결 URL
# 개발 환경 (Docker Compose): redis://redis:6379/0
# 로컬 개발: redis://localhost:6379/0
# 프로덕션: redis://redis-host:6379/0
REDIS_URL=redis://redis:6379/0

# Redis 개별 설정 (REDIS_URL과 일관성 유지)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis 연결 풀 설정
REDIS_MAX_CONNECTIONS=10
REDIS_RETRY_ON_TIMEOUT=True

# 🔑 Google OAuth 2.0 설정
# -----------------------------------------------------------------------------
# Google Cloud Console에서 발급받은 OAuth 2.0 자격 증명
# 발급 방법: https://console.cloud.google.com/ → 사용자 인증 정보 → OAuth 2.0 클라이언트 ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google OAuth 2.0 Redirect URI
# 개발 환경: http://localhost:8000/api/v1/auth/callback
# 프로덕션: https://yourdomain.com/api/v1/auth/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# =============================================================================
# 🌐 애플리케이션 설정 (선택적)
# =============================================================================

# 애플리케이션 정보
APP_NAME=Linux Daily Tips API
APP_VERSION=1.0.0
DESCRIPTION=Backend API for Linux Daily Tips educational platform

# 실행 환경
# 가능한 값: development, staging, production
ENVIRONMENT=development

# 디버그 모드 (프로덕션에서는 False 설정 권장)
DEBUG=True

# 로그 레벨
# 가능한 값: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# 로그 파일 설정
LOG_FILE=logs/app.log
LOG_ROTATION=daily
LOG_RETENTION_DAYS=30

# 서버 설정
HOST=0.0.0.0
PORT=8000
RELOAD=True
WORKERS=1

# =============================================================================
# ⏱️ 타임아웃 및 세션 설정 (선택적)
# =============================================================================

# HTTP 클라이언트 타임아웃 (초)
# Google OAuth API 호출 타임아웃
HTTP_TIMEOUT=10
HTTP_CONNECT_TIMEOUT=5

# 세션 만료 시간 (초)
# 기본값: 3600 (1시간)
# 24시간: 86400
SESSION_TTL=3600

# 터미널 세션 자동 만료 시간 (분)
# 기본값: 30분
# Docker 컨테이너 리소스 관리를 위한 설정
# 만료된 세션은 백그라운드 크론잡이 자동으로 정리
SESSION_EXPIRY_MINUTES=30

# OAuth State 만료 시간 (초, CSRF 방어용)
# 기본값: 600 (10분)
OAUTH_STATE_TTL=600

# =============================================================================
# 🔒 JWT 토큰 설정 (선택적)
# =============================================================================

# JWT 토큰 암호화 알고리즘
JWT_ALGORITHM=HS256

# 액세스 토큰 만료 시간 (분)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# 리프레시 토큰 만료 시간 (일)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# 🌍 CORS 설정 (선택적)
# =============================================================================

# CORS 허용 origin 목록 (개발 환경)
# JSON 배열 형식 또는 쉼표 구분 형식
# 예: ["http://localhost:3000","http://localhost:8000"]
# 예: http://localhost:3000,http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# 프로덕션 CORS 허용 origin 목록 (필수!)
# 프로덕션에서는 반드시 설정 필요 (미설정 시 서버 시작 실패)
# 예: ["https://yourdomain.com","https://www.yourdomain.com"]
CORS_ORIGINS_PRODUCTION=

# CORS 허용 메서드
CORS_METHODS=["GET","POST","PUT","DELETE","OPTIONS","PATCH"]

# CORS 허용 헤더
CORS_HEADERS=["*"]

# CORS 자격 증명 허용
CORS_CREDENTIALS=True

# =============================================================================
# 🍪 Cookie 보안 설정 (선택적)
# =============================================================================

# Cookie Secure 플래그 (HTTPS only)
# 프로덕션: True (HTTPS 사용 시)
# 개발: False (HTTP 허용)
COOKIE_SECURE=False

# Cookie HttpOnly 플래그 (XSS 방어)
# 항상 True 권장
COOKIE_HTTPONLY=True

# Cookie SameSite 정책 (CSRF 방어)
# 가능한 값: lax, strict, none
COOKIE_SAMESITE=lax

# =============================================================================
# 🌐 프론트엔드 URL 설정 (선택적)
# =============================================================================

# 프론트엔드 애플리케이션 URL (OAuth 리다이렉트용)
# 개발 환경: http://localhost:3000
# 프로덕션: https://yourdomain.com
FRONTEND_URL=http://localhost:3000

# 허용된 프론트엔드 URL 화이트리스트 (Open Redirect 방지)
# JSON 배열 형식
# 예: ["http://localhost:3000","http://localhost:3001"]
ALLOWED_FRONTEND_URLS=["http://localhost:3000"]

# =============================================================================
# 🐳 터미널 에뮬레이터 설정 (선택적)
# =============================================================================

# 명령어 실행 타임아웃 (초)
TERMINAL_TIMEOUT=30

# Docker 컨테이너 리소스 제한
TERMINAL_MAX_MEMORY=512m
TERMINAL_MAX_CPU=0.5

# 최대 동시 세션 수
TERMINAL_MAX_SESSIONS=100

# 컨테이너 이름 프리픽스
TERMINAL_CONTAINER_PREFIX=linuxtips_terminal_

# Docker 호스트 (Unix socket)
DOCKER_HOST=unix:///var/run/docker.sock

# =============================================================================
# 🚦 Rate Limiting 설정 (선택적)
# =============================================================================

# Rate Limit 요청 수 (기본값: 100)
RATE_LIMIT_REQUESTS=100

# Rate Limit 기간 (초, 기본값: 60)
RATE_LIMIT_PERIOD=60

# Rate Limit Redis 키 프리픽스
RATE_LIMIT_REDIS_KEY_PREFIX=ratelimit:

# =============================================================================
# 👤 관리자 설정 (선택적)
# =============================================================================

# 관리자 이메일
ADMIN_EMAIL=admin@linuxtips.dev

# 관리자 비밀번호 (초기 설정용)
ADMIN_PASSWORD=changeme

# 관리자 사용자명
ADMIN_USERNAME=admin

# =============================================================================
# 📧 이메일 설정 (선택적)
# =============================================================================

# SMTP 서버 설정
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
SMTP_FROM=noreply@linuxtips.dev

# =============================================================================
# 💰 Google AdSense 설정 (선택적)
# =============================================================================

# Google AdSense Client ID
GOOGLE_ADSENSE_CLIENT_ID=

# Google AdSense Publisher ID
GOOGLE_ADSENSE_PUBLISHER_ID=

# AdSense 활성화 여부
ADSENSE_ENABLED=False

# =============================================================================
# 📊 모니터링 및 분석 설정 (선택적)
# =============================================================================

# Sentry DSN (에러 트래킹)
SENTRY_DSN=

# Sentry 환경
SENTRY_ENVIRONMENT=development

# PostHog API Key (사용자 분석)
POSTHOG_API_KEY=

# PostHog 호스트
POSTHOG_HOST=https://app.posthog.com

# =============================================================================
# 🤖 LLM API 설정 (선택적)
# =============================================================================

# OpenAI API Key
OPENAI_API_KEY=

# OpenAI 모델
OPENAI_MODEL=gpt-4

# OpenAI 최대 토큰 수
OPENAI_MAX_TOKENS=2000

# OpenAI Temperature
OPENAI_TEMPERATURE=0.7

# Anthropic API Key (Claude)
BACKEND_ANTHROPIC_API_KEY=

# Anthropic 모델
BACKEND_ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Anthropic 최대 토큰 수
BACKEND_ANTHROPIC_MAX_TOKENS=2000

# =============================================================================
# 📂 파일 업로드 설정 (선택적)
# =============================================================================

# 최대 파일 크기 (바이트)
# 기본값: 10485760 (10MB)
MAX_FILE_SIZE=10485760

# 허용된 파일 확장자 (쉼표 구분)
# 예: .txt,.md,.json,.yaml,.yml
ALLOWED_FILE_TYPES=.txt,.md,.json,.yaml,.yml

# 업로드 디렉토리
UPLOAD_DIR=uploads/

# =============================================================================
# 🗄️ 캐시 설정 (선택적)
# =============================================================================

# 캐시 활성화 여부
CACHE_ENABLED=True

# 캐시 TTL (초)
# 기본값: 3600 (1시간)
CACHE_TTL=3600

# 캐시 최대 크기
CACHE_MAX_SIZE=1000

# =============================================================================
# 🔐 보안 키 생성 스크립트
# =============================================================================
# scripts/generate_keys.py 실행으로 SECRET_KEY와 REDIS_ENCRYPTION_KEY 생성:
#   cd backend
#   python scripts/generate_keys.py
#
# ⚠️ 생성된 키들을 이 파일에 복사하세요!
# ⚠️ Git에 커밋하지 마세요!
# =============================================================================
