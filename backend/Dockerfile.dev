# Development Dockerfile for FastAPI Backend
# Optimized for hot reloading and development workflow with uv

FROM python:3.14-slim-trixie

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    libpq-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install uv (ultra-fast Python package installer)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh && \
    mv /root/.local/bin/uv /usr/local/bin/uv && \
    mv /root/.local/bin/uvx /usr/local/bin/uvx

WORKDIR /app

# Copy all source code first (needed for editable install)
COPY . .

# Install dependencies directly to system Python (no venv needed in Docker)
# --system flag installs to system Python, --no-cache for smaller image
# -e for editable mode (dev環境에 유용)
RUN uv pip install --system --no-cache -e ".[dev,test]"

# Expose port
EXPOSE 8000

# Development command with hot reloading
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]